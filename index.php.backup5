</div>

<script>
// Tab System
const hash = window.location.hash || '#console';
const tabs = document.querySelectorAll('.tab-btn');
const contents = document.querySelectorAll('.tab-content');

function switchTab(targetId) {
    tabs.forEach(t => t.classList.remove('active'));
    contents.forEach(c => c.classList.remove('active'));
    const btn = document.querySelector(`.tab-btn[data-tab="${targetId}"]`);
    const content = document.getElementById(`tab-${targetId}`);
    if(btn && content) {
        btn.classList.add('active');
        content.classList.add('active');
        window.history.replaceState(null, null, `#${targetId}`);
        if(targetId === 'console') scrollToBottom(true);
    }
}
tabs.forEach(btn => {
    btn.addEventListener('click', () => switchTab(btn.dataset.tab));
});
if(document.getElementById(`tab-${hash.substring(1)}`)) switchTab(hash.substring(1));

// Interactive Console Logic
const serverId = <?=$selected ? (int)$selected['id'] : 'null'?>;
const term = document.getElementById('terminal');
const cliInput = document.getElementById('cli-input');
let isUserScrolling = false;

function scrollToBottom(force = false) {
    if(term && (!isUserScrolling || force)) term.scrollTop = term.scrollHeight;
}

if(term) {
    term.addEventListener('scroll', () => {
        // Deteksi jika user sedang scroll ke atas
        isUserScrolling = term.scrollHeight - term.clientHeight - term.scrollTop > 10;
    });

    async function fetchLog() {
        if(!serverId) return;
        try {
            const res = await fetch(`?api=log&id=${serverId}`, {cache:'no-store'});
            const data = await res.json();
            if(data.ok && data.log) {
                if(term.textContent !== data.log) {
                    term.textContent = data.log;
                    scrollToBottom();
                }
            }
        } catch(e) {}
    }
    
    // Auto refresh log
    setInterval(fetchLog, 1500);
    scrollToBottom(true);

    // Kirim Perintah (Stdin)
    if(cliInput) {
        cliInput.addEventListener('keypress', async (e) => {
            if(e.key === 'Enter') {
                const cmd = cliInput.value.trim();
                if(cmd === '') return;
                cliInput.disabled = true;
                
                const fd = new FormData();
                fd.append('id', serverId);
                fd.append('cmd', cmd);
                
                try {
                    await fetch('?api=command', { method: 'POST', body: fd });
                    cliInput.value = '';
                    setTimeout(fetchLog, 300); // Fetch cepat setelah enter
                } catch(err) {
                    console.error("Gagal mengirim perintah");
                }
                cliInput.disabled = false;
                cliInput.focus();
            }
        });
    }
}
</script>
</body></html>
<?php return (string)ob_get_clean(); }
