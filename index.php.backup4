            <div class="panel-title"><?=icon('file')?> Edit: <?=h($fileRel)?></div>
            <div class="toolbar">
                <a href="?server=<?=urlencode($selected['slug'])?>&dir=<?=urlencode(dirname($fileRel)==='.'?'':dirname($fileRel))?>" class="btn"><?=icon('back')?> Close</a>
                <a href="?action=file_download&id=<?=$selected['id']?>&path=<?=urlencode($fileRel)?>" class="btn"><?=icon('download')?> Download</a>
