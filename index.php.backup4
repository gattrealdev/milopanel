        <a href="?action=logout" class="text-muted" style="font-size:13px; display:flex; gap:8px; align-items:center"><?=icon('x')?> Log out</a>
    </div>
</aside>

<main class="main-content">
<?php if(!$selected): ?>
    <div class="center-screen" style="min-height:60vh; text-align:center">
        <div style="color:var(--text-muted); margin-bottom:16px"><?=icon('server')?></div>
        <h2>Welcome to MiloPanel</h2>
        <p class="text-muted">Create a server from the sidebar to get started.</p>
    </div>
<?php else: 
    $run=status_of($selected)==='running'; 
    $log=tail_log(log_file($selected),16000);
?>
    <div class="header">
        <div>
            <h1><?=h($selected['name'])?></h1>
            <div class="text-muted mt-2" style="font-size:13px; display:flex; align-items:center; gap:16px">
                <span style="display:flex; align-items:center; gap:6px"><span class="status-dot <?=$run?'running':''?>"></span> <?=$run?'Running':'Offline'?></span>
                <span>PID: <?=proc_pid($selected)?:'—'?></span>
            </div>
        </div>
        <div class="toolbar">
            <form method="post" action="?action=toggle" style="display:inline"><input type="hidden" name="csrf" value="<?=h($csrf)?>"><input type="hidden" name="id" value="<?=h((string)$selected['id'])?>"><button class="btn <?=$run?'danger':'success'?>"><?=$run?icon('stop').' Stop':icon('play').' Start'?></button></form>
            <form method="post" action="?action=restart" style="display:inline"><input type="hidden" name="csrf" value="<?=h($csrf)?>"><input type="hidden" name="id" value="<?=h((string)$selected['id'])?>"><button class="btn"><?=icon('restart')?> Restart</button></form>
        </div>
    </div>

    <!-- System Telemetry Widgets -->
    <div class="stat-grid">
        <div class="stat-card">
            <span class="stat-label"><?=icon('cpu')?> CPU Load (1m)</span>
            <span class="stat-value"><?=h((string)$sys['load'])?></span>
        </div>
        <div class="stat-card">
            <span class="stat-label">RAM Usage</span>
            <?php if($sys['ram_total']): $usedRam = $sys['ram_total']-$sys['ram_free']; $ramPct = min(100, round(($usedRam/$sys['ram_total'])*100)); ?>
                <span class="stat-value"><?=format_bytes((int)$usedRam)?> <span class="text-muted" style="font-size:14px">/ <?=format_bytes((int)$sys['ram_total'])?></span></span>
                <div class="progress-bar"><div class="progress-fill" style="width:<?=$ramPct?>%"></div></div>
            <?php else: ?> <span class="stat-value">N/A</span> <?php endif; ?>
        </div>
        <div class="stat-card">
            <span class="stat-label">Disk Storage</span>
            <?php if($sys['disk_total']): $usedDisk = $sys['disk_total']-$sys['disk_free']; $diskPct = min(100, round(($usedDisk/$sys['disk_total'])*100)); ?>
                <span class="stat-value"><?=format_bytes((int)$usedDisk)?> <span class="text-muted" style="font-size:14px">/ <?=format_bytes((int)$sys['disk_total'])?></span></span>
                <div class="progress-bar"><div class="progress-fill" style="width:<?=$diskPct?>%"></div></div>
            <?php else: ?> <span class="stat-value">N/A</span> <?php endif; ?>
        </div>
    </div>

    <?php if($fileRel!==''): // Editor Mode ?>
