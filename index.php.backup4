            <form method="post" action="?action=delete" onsubmit="return confirm('WARNING: This will delete the server and ALL its files. Continue?')">
                <input type="hidden" name="csrf" value="<?=h($csrf)?>"><input type="hidden" name="id" value="<?=h((string)$selected['id'])?>">
                <button class="btn danger w-full"><?=icon('trash')?> Delete Server</button>
            </form>
        </section>
    </div>

    <!-- File Manager -->
    <section class="panel">
        <div class="panel-header">
            <div class="panel-title"><?=icon('folder')?> File Manager <span class="text-muted" style="font-size:13px; font-weight:normal">/<?=h($dirRel)?></span></div>
        </div>
        <?=files_html($selected, $dirRel)?>
    </section>

    <?php endif; ?>
<?php endif; ?>
</main>
</div>
<script>
const serverId=<?=$selected?(int)$selected['id']:'null'?>;
async function refreshLog(){if(!serverId)return;try{const r=await fetch('?api=log&id='+serverId,{cache:'no-store'});const j=await r.json();document.getElementById('console').textContent=j.log||'No output yet.';const c=document.getElementById('console');c.scrollTop=c.scrollHeight}catch(e){}}
function copyLog(){navigator.clipboard?.writeText(document.getElementById('console').textContent); alert('Log copied to clipboard');}
if(serverId && document.getElementById('console')){setInterval(refreshLog,2500); refreshLog();}
</script></body></html><?php return (string)ob_get_clean(); }

echo main_page($servers, $selected, $fileRel, $dirRel, $editing);
