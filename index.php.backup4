function main_page(array $servers, ?array $selected, string $fileRel, string $dirRel, string $editing): string { ob_start(); $csrf=csrf(); $sys=sysinfo(); ?>
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><?=h(APP_NAME)?></title><?=css()?></head><body>
<div class="layout">
<aside class="sidebar">
    <div class="sidebar-header">
        <div class="brand"><?=icon('server')?> Milo<span>Panel</span></div>
        <div class="text-muted mt-2" style="font-size:12px">PHP <?=h(PHP_VERSION)?> &middot; <?=h(PHP_OS_FAMILY)?></div>
    </div>
    
    <div class="server-list">
        <div style="padding: 0 8px; margin-bottom:8px; display:flex; justify-content:space-between; align-items:center">
