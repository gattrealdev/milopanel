        <div class="text-muted" style="padding:0 8px; font-size:13px">No servers found.</div>
        <?php endif; ?>
    </div>

    <div style="margin-top:24px; padding: 0 8px;">
        <form method="post" action="?action=create" class="card" style="padding:12px; background:var(--bg)">
