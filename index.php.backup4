                <label>Startup Command</label><textarea class="input" name="command" rows="3"><?=h($selected['command'])?></textarea>
                <label>Working Directory (Root)</label><input class="input" name="cwd" value="<?=h($selected['cwd'])?>">
                <label style="display:flex; align-items:center; gap:8px; margin-top:16px; color:var(--text)"><input type="checkbox" name="autostart" <?=$selected['autostart']?'checked':''?>> Start on panel boot</label>
